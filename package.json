  "description": "Lightweight collaborative document editor",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:e2e": "node scripts/e2e-smoke.cjs"
  },
