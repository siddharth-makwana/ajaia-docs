    "marked": "^18.2.0",
    "multer": "^2.5.0",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
